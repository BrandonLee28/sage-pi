{
  "name": "personal-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "sage": "bin/sage.mjs" },
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "sage": "node bin/sage.mjs",
    "connect": "node bin/sage.mjs connect",
    "start": "node bin/sage.mjs",
    "dev": "node bin/sage.mjs",
    "gateway": "node bin/sage.mjs gateway",
    "daemon": "node bin/sage.mjs gateway",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:docker": "node test/docker.ts",
    "voice:setup": "node scripts/setup-voice.ts",
    "voice:try": "node bin/sage.mjs connect",
    "test:live": "node --env-file-if-exists=.env test/live.ts",
    "test:cua-performance": "node --env-file-if-exists=.env test/cua-performance.live.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@googleworkspace/cli": "0.22.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cron-parser": "5.10.2",
    "grammy": "1.46.0",
    "ical.js": "2.2.1",
    "mammoth": "1.13.0",
    "puppeteer-core": "25.14.0",
    "tsdav": "2.5.0",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
