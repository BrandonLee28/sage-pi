# Copy to .env. This endpoint was supplied by you; the model ID was discovered from /models.
LLM_BASE_URL=http://100.94.249.19:8080/v1
LLM_MODEL=bonsai-27b
LLM_CONTEXT=65536
# Total generation budget, including reasoning. Too little can leave no visible answer.
LLM_MAX_TOKENS=8192
# LLM_API_KEY=
DATA_DIR=./data
TZ=America/New_York

# Optional services. Unconfigured tools are not offered to the model.
SEARXNG_URL=http://100.94.249.19:8888
FIRECRAWL_URL=http://100.94.249.19:3002
# FIRECRAWL_API_KEY=
# LIGHTPANDA_URL=ws://your-lightpanda:9222
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional override; Gmail credentials otherwise live under DATA_DIR/google.
# GOOGLE_WORKSPACE_CLI_CONFIG_DIR=/absolute/path/to/google-config
# iCloud Calendar: an Apple app-specific password, not your main account password.
# APPLE_ID=
# APPLE_APP_PASSWORD=
# APPLE_CALENDAR_URL=

# Pi's built-in read/write/edit/bash tools use the server user's permissions.
# The working directory is DATA_DIR/workspace; it is not a filesystem sandbox.
ENABLE_SHELL=true

# Optional local hands-free voice (macOS; install bindings with npm run voice:setup).
# Model may also be a local folder containing config.json, tokenizer.json,
# model.q8.gguf, and default-voice.safetensors downloaded from Hugging Face.
# VOICE_TTS_MODEL=hf://gradium/phonon-40m-en
# VOICE_ASR_MODEL=base.en
# VOICE_TTS_VOICE=default
# Pause before transcribing; multiple of 20, from 200 to 2000 milliseconds.
# VOICE_SILENCE_MS=400
# Optional paths; defaults use DATA_DIR/voice. Audio uses the Mac's default input/output.
# VOICE_DATA_DIR=/absolute/path/to/voice-assets
# VOICE_PYTHON=/absolute/path/to/voice/runtime/bin/python
# VOICE_AUDIO=/absolute/path/to/voice/audio
